# Copy this file to .env and fill in real values before running docker compose up --build
# Docker Compose reads the root .env automatically for the ${VAR} substitutions in docker-compose.yml.

DB_HOST=db
DB_USER=root
DB_PASS=change_me
DB_NAME=salon_db

JWT_SECRET=change_me
JWT_EXPIRE=7d
PASS_SALT=10

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=change_me

EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional - leave empty when not using Redis
REDIS_URL=

VITE_API_URL=http://localhost:5000/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
